# Copy to .env.local and fill in. .env.local is gitignored -- never commit real keys.

# ---------------------------------------------------------------------------
# Google Business Profile reviews (optional)
# ---------------------------------------------------------------------------
# Without these the reviews section falls back to the sample data in
# src/lib/site.ts and shows a visible "sample reviews" warning.
#
# 1. Google Cloud console -> enable "Places API (New)" on a project with
#    billing enabled.
# 2. Create an API key and restrict it to the Places API. Keep it server-side;
#    it must NOT be prefixed NEXT_PUBLIC_.
# 3. Find your Place ID with the Place ID Finder:
#    https://developers.google.com/maps/documentation/places/web-service/place-id
#
# Billing: requesting the `reviews` field bills at Google's Place Details
# Enterprise SKU. Responses are cached for 6 hours, so a normal marketing site
# makes roughly 4 calls a day.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ---------------------------------------------------------------------------
# Contact form (optional)
# ---------------------------------------------------------------------------
# Without this the form composes a mailto: to the address in src/lib/site.ts,
# which works with no backend. Set it to a form endpoint (Formspree, Basin, or
# your own route handler) to post properly instead.
NEXT_PUBLIC_FORM_ENDPOINT=

# ---------------------------------------------------------------------------
# Canonical site URL (optional)
# ---------------------------------------------------------------------------
# Used for absolute URLs in metadata and the OpenGraph share card. Defaults to
# https://promodernmedia.co.uk, which is a PLACEHOLDER -- set this to the real
# domain once it is live, or share links will point at the wrong host.
NEXT_PUBLIC_SITE_URL=
