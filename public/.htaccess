# Apache config for the static export (GoDaddy cPanel and similar hosts).
# Next.js copies everything in public/ into out/, so this ships with the site.
# Ignored entirely on Vercel, which is not Apache.

# ---------------------------------------------------------------------------
# OpenGraph card MIME type
# ---------------------------------------------------------------------------
# Next exports the share card as a file with NO extension ("opengraph-image").
# Apache would send it as application/octet-stream and Facebook, WhatsApp and
# LinkedIn would silently ignore it, so link previews would show no image.
<Files "opengraph-image">
  ForceType image/png
</Files>

# ---------------------------------------------------------------------------
# Force HTTPS
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------
# Custom 404
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
# Files under /_next/static/ carry a content hash in the name, so they can be
# cached forever. HTML must NOT be, or visitors keep seeing the old site after
# you upload a new build.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 hour"
  ExpiresByType image/png               "access plus 1 month"
  ExpiresByType image/jpeg              "access plus 1 month"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Basic security headers. A static site needs little, but these are free.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Stop Apache listing directory contents if an index file is ever missing.
Options -Indexes
